@model IEnumerable<soccer.Models.Player>

@{
    ViewData["Title"] = "Players";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .player-hero {
        background: linear-gradient(rgba(10,10,10,.78), rgba(10,10,10,.85)), url('/images/background.jpg');
        background-size: cover;
        background-position: center;
    }

    .player-card {
        background: #20242d;
        border-radius: 18px;
        overflow: hidden;
        transition: .35s;
        color: white;
    }

        .player-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 18px 40px rgba(0,0,0,.4);
        }

    .player-image {
        width: 100%;
        height: 320px;
        object-fit: cover;
    }

    .player-info {
        padding: 20px;
    }

    .rating {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #00c853;
        color: white;
        padding: 8px 15px;
        border-radius: 30px;
        font-weight: bold;
        font-size: 15px;
    }

    .player-name {
        font-size: 24px;
        font-weight: 700;
    }

    .player-position {
        color: #cfcfcf;
    }

    .stat-box {
        background: #2b313d;
        border-radius: 10px;
        padding: 12px;
        text-align: center;
        margin-top: 10px;
    }

        .stat-box h4 {
            color: #ffce3a;
            margin-bottom: 4px;
        }

        .stat-box p {
            margin: 0;
            color: #ccc;
        }

    .section-dark {
        background: #181c23;
        padding: 80px 0;
    }

    .section-title {
        color: white;
        font-weight: 700;
    }

    .search-area {
        background: #20242d;
        padding: 30px;
        border-radius: 15px;
    }

        .search-area input {
            background: #2d3442;
            border: none;
            color: white;
        }

        .search-area select {
            background: #2d3442;
            border: none;
            color: white;
        }

    .table-dark-custom {
        background: #20242d;
        color: white;
    }

        .table-dark-custom thead {
            background: #11151c;
        }

</style>





<div class="hero overlay player-hero">

    <div class="container">

        <div class="row align-items-center justify-content-center"
             style="height:430px;">

            <div class="col-lg-8 text-center">

                <h1 class="display-3 text-white">

                    Players Statistics

                </h1>

                <p class="text-light">

                    Goals • Assists • Ratings • Weekly Performance

                </p>

            </div>

        </div>

    </div>

</div>
<div class="section-dark">

    <div class="container">

        <div class="row mb-5">

            <div class="col-6">

                <h2 class="section-title">

                    ⭐ Top Rated Players

                </h2>

            </div>

            <div class="col-6 text-right">

                <div class="custom-nav">

                    <a href="#" class="js-custom-prev-v2">
                        <span class="icon-keyboard_arrow_left"></span>
                    </a>

                    <a href="#" class="js-custom-next-v2">
                        <span class="icon-keyboard_arrow_right"></span>
                    </a>

                </div>

            </div>

        </div>

        <div class="owl-4-slider owl-carousel">
            @foreach (var player in Model.Where(x => x.Rating >= 8.5))
            {

                <div class="item">

                    <div class="player-card">

                        <div class="position-relative">

                            <img src="@player.ImageUrl"
                                 class="player-image">

                            <div class="rating">

                                ⭐ @player.Rating

                            </div>

                        </div>

                        <div class="player-info">

                            <div class="player-name">

                                @player.Name

                            </div>

                            <div class="player-position">

                                #@player.Number |
                                @player.Position

                            </div>

                            <div class="row mt-3">

                                <div class="col-6">

                                    <div class="stat-box">

                                        <h4>@player.WeeklyGoals</h4>

                                        <p>Weekly Goals</p>

                                    </div>

                                </div>

                                <div class="col-6">

                                    <div class="stat-box">

                                        <h4>@player.WeeklyAssists</h4>

                                        <p>Weekly Assists</p>

                                    </div>

                                </div>

                                <div class="col-6">

                                    <div class="stat-box">

                                        <h4>@player.TotalGoals</h4>

                                        <p>Total Goals</p>

                                    </div>

                                </div>

                                <div class="col-6">

                                    <div class="stat-box">

                                        <h4>@player.TotalAssists</h4>

                                        <p>Total Assists</p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            }
        </div>

    </div>

</div>