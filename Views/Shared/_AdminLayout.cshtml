<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Admin Panel - Futbol Klubu</title>
    
    <!-- Tabler CSS Fayllari (wwwroot/admin daxilindeki fayllar) -->
    <link rel="stylesheet" href="~/admin/css/tabler.min.css" />
    <link rel="stylesheet" href="~/admin/css/tabler-flags.min.css" />
    <link rel="stylesheet" href="~/admin/css/tabler-payments.min.css" />
    <link rel="stylesheet" href="~/admin/css/tabler-vendors.min.css" />
    <!-- Ikonlar ucun FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <div class="page">
        <!-- HEADER / TOPBAR -->
        <header class="navbar navbar-expand-md navbar-light d-print-none">
            <div class="container-xl">
                <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pr-0 pr-md-3">
                    <a href="/Admin/Index" class="text-danger font-weight-bold" style="text-decoration:none;">
                        ⚽ FUTBOL FK - ADMIN
                    </a>
                </h1>
                <div class="navbar-nav flex-row order-md-last">
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown">
                            <span class="avatar avatar-sm" style="background-image: url('https://cdn-icons-png.flaticon.com/512/3135/3135715.png')"></span>
                            <div class="d-none d-xl-block ps-2">
                                <div>@User.Identity?.Name</div>
                                <div class="mt-1 small text-muted">Administrator</div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                            <a href="/Blog/Blog" class="dropdown-item" target="_blank">Sayta Kecid</a>
                            <div class="dropdown-divider"></div>
                            <a href="/Account/Logout" class="dropdown-item text-danger">Cixis</a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- MENU BAR -->
        <div class="navbar-expand-md">
            <div class="collapse navbar-collapse" id="navbar-menu">
                <div class="navbar navbar-light">
                    <div class="container-xl">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-chart-line"></i></span>
                                    <span class="nav-link-title">Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Tickets">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-ticket"></i></span>
                                    <span class="nav-link-title">Bilet Sifarisleri</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Blogs">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-newspaper"></i></span>
                                    <span class="nav-link-title">Blog Idareetmesi</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- DYNAMIC CONTENT (Sehifelerin kontenti bura gelecek) -->
        <div class="page-wrapper">
            <div class="container-xl pt-4">
                @RenderBody()
            </div>
            
            <footer class="footer footer-transparent d-print-none mt-auto py-3">
                <div class="container-xl text-center text-muted">
                    © 2026 Futbol FK Admin Panel. Butun huquqlar qorunur.
                </div>
            </footer>
        </div>
    </div>

    <!-- Tabler JS Fayllari -->
    <script src="~/admin/js/tabler.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>