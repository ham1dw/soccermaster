@model soccer.Models.NewsItem

<div class="col-md-4">
    <div class="post-entry">
        <a href="#"><img src="~/images/@Model.ImageUrl" alt="Image" class="img-fluid"></a>
        <div class="caption">
            <div class="caption-inner">
                <h2 class="text-white" style="font-size: 20px; font-weight: 600; line-height: 1.3; margin-bottom: 15px;">
                    <a href="/Blog/Blog?id=@Model.Id" class="text-white text-decoration-none">
                        @Model.Title
                    </a>
                </h2>
                <div class="author d-flex align-items-center">
                    <div class="img mb-2 mr-3">
                        <img src="~/images/@Model.AuthorImageUrl" alt="authorimage">
                    </div>
                    <div class="text">
                        <h4>@Model.Author</h4>
                        <span>@Model.Date.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>