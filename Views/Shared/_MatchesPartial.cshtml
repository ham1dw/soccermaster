@model IEnumerable<soccer.Models.Match>

@functions {
    string ExtractTeam(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw;
        var r = raw.Trim();
        var lastOpen = r.LastIndexOf('(');
        var lastClose = r.LastIndexOf(')');
        if (lastOpen >= 0 && lastClose > lastOpen)
        {
            // take content of last parentheses as team name
            var inside = r.Substring(lastOpen + 1, lastClose - lastOpen - 1).Trim();
            if (!string.IsNullOrEmpty(inside) && inside.ToLower() != "win" && inside.ToLower() != "loss")
            {
                return inside;
            }
        }
        return r;
    }

    bool IsValidPlayer(string p) => !string.IsNullOrWhiteSpace(p) && p.Trim().ToLower() != "win" && p.Trim().ToLower() != "loss";
}

@foreach (var match in Model)
{
    var homeTeam = ExtractTeam(match.HomeTeam);
    var awayTeam = ExtractTeam(match.AwayTeam);

    <div class="d-flex team-vs justify-content-center align-items-center">
        <div class="team-1 w-50">
            <div class="team-details w-100 text-center">
                <img src="@(match != null ? match.Team1LogoUrl : "")" alt="Image">
                <h3>@homeTeam <span>(@match.HomeResult)</span></h3>
                <ul class="list-unstyled">
                    @if (IsValidPlayer(match.HomePlayer1)) { <li>@match.HomePlayer1</li> }
                    @if (IsValidPlayer(match.HomePlayer2)) { <li>@match.HomePlayer2</li> }
                    @if (IsValidPlayer(match.HomePlayer3)) { <li>@match.HomePlayer3</li> }
                    @if (IsValidPlayer(match.HomePlayer4)) { <li>@match.HomePlayer4</li> }
                </ul>
            </div>
        </div>
        <span class="score mx-4 fs-3">@match.HomeScore - @match.AwayScore</span>
        <div class="team-2 w-50">
            <div class="team-details w-100 text-center">
                <img src="@(match != null ? match.Team2LogoUrl : "")" alt="Image">
                <h3>@awayTeam <span>(@match.AwayResult)</span></h3>
                <ul class="list-unstyled">
                    @if (IsValidPlayer(match.AwayPlayer1)) { <li>@match.AwayPlayer1</li> }
                    @if (IsValidPlayer(match.AwayPlayer2)) { <li>@match.AwayPlayer2</li> }
                    @if (IsValidPlayer(match.AwayPlayer3)) { <li>@match.AwayPlayer3</li> }
                    @if (IsValidPlayer(match.AwayPlayer4)) { <li>@match.AwayPlayer4</li> }
                </ul>
            </div>
        </div>
    </div>
}
