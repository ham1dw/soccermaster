@model soccer.Models.NewsItem
@{
    ViewData["Title"] = "Xeber Detallari";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title"><i class="fe fe-file-text mr-2"></i>@Model.Title</h1>
</div>

<div class="card">
    <div class="card-body">
        <p class="text-muted">@Model.Author &middot; @Model.Date.ToString("yyyy-MM-dd")</p>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" />
        }
        <div>
            @Html.Raw(Model.Content)
        </div>
    </div>
    <div class="card-footer text-right">
        <a asp-action="Index" class="btn btn-outline-secondary">Geri</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Redakte et</a>
    </div>
</div>
