@model soccer.Models.NewsItem
@{
    ViewData["Title"] = "Xeberi Sil";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title text-danger"><i class="fe fe-alert-triangle mr-2"></i>Xeberi Sil</h1>
</div>

<div class="card">
    <div class="card-body">
        <p class="text-muted">Bu xeberi silmek istediyinize eminsiniz? Bu emeliyyat geri qaytarila bilmez.</p>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" style="max-height:200px;object-fit:cover;" />
        }
        <dl class="row">
            <dt class="col-3">Basliq</dt>
            <dd class="col-9">@Model.Title</dd>
            <dt class="col-3">Muellif</dt>
            <dd class="col-9">@Model.Author</dd>
            <dt class="col-3">Tarix</dt>
            <dd class="col-9">@Model.Date.ToString("yyyy-MM-dd")</dd>
        </dl>
    </div>
    <div class="card-footer text-right">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-outline-secondary">Legv et</a>
            <button type="submit" class="btn btn-danger">Beli, sil</button>
        </form>
    </div>
</div>
