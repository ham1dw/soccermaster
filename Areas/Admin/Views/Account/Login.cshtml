@model soccer.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Admin Giris";
    Layout = "~/Areas/Admin/Views/Shared/_AdminAuthLayout.cshtml";
}

<form class="card" asp-action="Login" method="post">
    @Html.AntiForgeryToken()
    <div class="card-body p-6">
        <div class="card-title">Admin panele giris</div>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="form-group">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" name="Email" id="Email" class="form-control" placeholder="hamidmurad06@gmail.com" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" name="Password" id="Password" class="form-control" placeholder="muradov2006" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-group">
            <label class="custom-control custom-checkbox">
                <input asp-for="RememberMe" class="custom-control-input" />
                <span class="custom-control-label">Meni xatirla</span>
            </label>
        </div>
        <div class="form-footer">
            <button type="submit" class="btn btn-primary btn-block">Daxil ol</button>
        </div>
    </div>
</form>
<div class="text-center text-muted mt-3">
    <a asp-controller="Home" asp-action="Index">&larr; Sayta qayit</a>
</div>
