@using Microsoft.AspNetCore.Identity
@inject SignInManager<soccer.Models.AppUser> SignInManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(string controller) => currentController == controller ? "nav-link active" : "nav-link";
}<!doctype html><html lang="az"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Soccer Admin</title>

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/admin/css/dashboard.css" rel="stylesheet" />
    <style>
        .header-brand-img { height: 28px; }
        .card-table td, .card-table th { vertical-align: middle; }
        .empty-state { text-align: center; padding: 60px 20px; color: #9aa0ac; }
        .empty-state i { font-size: 42px; margin-bottom: 12px; display: block; }
        .thumb-sm { width: 42px; height: 42px; object-fit: cover; border-radius: 4px; }
    </style>
    @await RenderSectionAsync("Styles", required: false)</head><body>
    <div class="page">
        <div class="page-main">
            <div class="header py-4">
                <div class="container">
                    <div class="d-flex">
                        <a class="header-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="fe fe-shield mr-2"></i><strong>Soccer Admin</strong>
                        </a>
                        <div class="d-flex order-lg-2 ml-auto">
                            <div class="nav-item d-none d-md-flex">
                                <a href="/" class="btn btn-sm btn-outline-primary" target="_blank">Sayta kecid</a>
                            </div>
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <div class="dropdown">
                                    <a href="javascript:void(0)" class="nav-link pr-0 leading-none" data-toggle="dropdown">
                                        <span class="avatar" style="background-image:url(https://ui-avatars.com/api/?background=206bc4&color=fff&name=@User.Identity.Name)"></span>
                                        <span class="ml-2 d-none d-lg-block">
                                            <span class="text-default">@User.Identity.Name</span>
                                            <small class="text-muted d-block mt-1">Administrator</small>
                                        </span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right dropdown-menu-arrow">
                                        <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">
                                                <i class="dropdown-icon fe fe-log-out"></i> Cixis
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                        <a href="javascript:void(0)" class="header-toggler d-lg-none ml-3 ml-lg-0" data-toggle="collapse" data-target="#headerMenuCollapse">
                            <span class="header-toggler-icon"></span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="header collapse d-lg-flex p-0" id="headerMenuCollapse">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg order-lg-first">
                            <ul class="nav nav-tabs border-0 flex-column flex-lg-row">
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@NavClass("Dashboard")"><i class="fe fe-home"></i> Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Matches" asp-action="Index" class="@NavClass("Matches")"><i class="fe fe-check-square"></i> Matclar</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="UpcomingMatches" asp-action="Index" class="@NavClass("UpcomingMatches")"><i class="fe fe-calendar"></i> Novbeti Matclar</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Standings" asp-action="Index" class="@NavClass("Standings")"><i class="fe fe-bar-chart-2"></i> Turnir Cedveli</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Players" asp-action="Index" class="@NavClass("Players")"><i class="fe fe-users"></i> Oyuncular</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="News" asp-action="Index" class="@NavClass("News")"><i class="fe fe-file-text"></i> Xeberler</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="HeroSections" asp-action="Index" class="@NavClass("HeroSections")"><i class="fe fe-image"></i> Hero Bolme</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="TicketOrders" asp-action="Index" class="@NavClass("TicketOrders")"><i class="fe fe-tag"></i> Bilet Sifarisleri</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="@NavClass("Users")"><i class="fe fe-user"></i> Istifadeciler</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="my-3 my-md-5">
                <div class="container">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible" role="alert">
                            @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </div>
            <footer class="footer">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-12 text-center text-muted">
                            &copy; @DateTime.Now.Year Soccer Admin Panel
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/js/dashboard.js"></script>
    @await RenderSectionAsync("Scripts", required: false)</body></html>