@using Microsoft.AspNetCore.Identity
@inject SignInManager<soccer.Models.AppUser> SignInManager
@inject UserManager<soccer.Models.AppUser> UserManager

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="m-0">@ViewData["Title"]</h4>
    </div>
    <div>
        @if (SignInManager.IsSignedIn(User))
        {
            <span class="mr-3">👤 @User.Identity.Name</span>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
            </form>
        }
        else
        {
            <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="btn btn-sm btn-primary">Admin Login</a>
        }
    </div>
</div>