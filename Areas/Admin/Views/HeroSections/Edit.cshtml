@model soccer.Models.HeroSection
@{
    ViewData["Title"] = "Hero Bolmeni Redakte Et";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title"><i class="fe fe-image mr-2"></i>Hero Bolmeni Redakte Et</h1>
</div>

<div class="card">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-group">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
            <div class="form-group">
                <label>Fon sekli</label>
                <input type="file" name="bgFile" class="form-control" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.BackgroundImage))
                {
                    <img src="@Model.BackgroundImage" class="mt-2" style="height:80px;border-radius:6px;" />
                }
            </div>
        </div>
        <div class="card-footer text-right">
            <a asp-action="Index" class="btn btn-outline-secondary">Legv et</a>
            <button type="submit" class="btn btn-primary">Yadda saxla</button>
        </div>
    </form>
</div>
