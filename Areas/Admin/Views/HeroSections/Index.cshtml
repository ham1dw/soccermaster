@model IEnumerable<soccer.Models.HeroSection>
@{
    ViewData["Title"] = "Hero Bolme";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title"><i class="fe fe-image mr-2"></i>Hero Bolme</h1>
    <div class="page-options d-flex">
        <a asp-action="Create" class="btn btn-primary"><i class="fe fe-plus mr-1"></i> Yeni</a>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fe fe-image"></i>
            <p>Hele hec bir hero bolmesi elave edilmeyib.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm">Ilk bolmeni elave et</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table card-table table-vcenter table-striped">
                <thead>
                    <tr>
                        <th>Sekil</th>
                        <th>Basliq</th>
                        <th class="text-right">Emeliyyat</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var h in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(h.BackgroundImage))
                            {
                                <img src="@h.BackgroundImage" class="thumb-sm" style="width:70px;height:44px;" />
                            }
                        </td>
                        <td>@h.Title</td>
                        <td class="text-right">
                            <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary" title="Redakte et"><i class="fe fe-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@h.Id" class="btn btn-sm btn-outline-danger" title="Sil"><i class="fe fe-trash-2"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
