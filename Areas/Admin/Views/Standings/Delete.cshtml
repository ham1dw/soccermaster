@model soccer.Models.Standing
@{
    ViewData["Title"] = "Setri Sil";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title text-danger"><i class="fe fe-alert-triangle mr-2"></i>Setri Sil</h1>
</div>

<div class="card">
    <div class="card-body">
        <p class="text-muted">Bu setri silmek istediyinize eminsiniz?</p>
        <dl class="row">
            <dt class="col-3">Komanda</dt>
            <dd class="col-9">@Model.TeamName</dd>
            <dt class="col-3">Yer</dt>
            <dd class="col-9">@Model.Position</dd>
        </dl>
    </div>
    <div class="card-footer text-right">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-outline-secondary">Legv et</a>
            <button type="submit" class="btn btn-danger">Beli, sil</button>
        </form>
    </div>
</div>
