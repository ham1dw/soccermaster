@model soccer.Models.Match
@{
    ViewData["Title"] = "Yeni Matc";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title"><i class="fe fe-check-square mr-2"></i>Yeni Matc Yarat</h1>
</div>

<div class="card">
    <form asp-action="Create" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-6">
                    <h4 class="mb-3">Ev sahibi komanda</h4>
                    <div class="form-group">
                        <label asp-for="HomeTeam" class="form-label"></label>
                        <input asp-for="HomeTeam" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="HomeScore" class="form-label"></label>
                        <input asp-for="HomeScore" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="HomePlayer1" class="form-label"></label>
                        <input asp-for="HomePlayer1" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Team1LogoUrl" class="form-label"></label>
                        <input asp-for="Team1LogoUrl" class="form-control" placeholder="https://..." />
                    </div>
                </div>
                <div class="col-md-6">
                    <h4 class="mb-3">Qonaq komanda</h4>
                    <div class="form-group">
                        <label asp-for="AwayTeam" class="form-label"></label>
                        <input asp-for="AwayTeam" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="AwayScore" class="form-label"></label>
                        <input asp-for="AwayScore" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="AwayPlayer1" class="form-label"></label>
                        <input asp-for="AwayPlayer1" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Team2LogoUrl" class="form-label"></label>
                        <input asp-for="Team2LogoUrl" class="form-control" placeholder="https://..." />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-right">
            <a asp-action="Index" class="btn btn-outline-secondary">Legv et</a>
            <button type="submit" class="btn btn-primary">Yadda saxla</button>
        </div>
    </form>
</div>
