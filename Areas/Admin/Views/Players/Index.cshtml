@model soccer.Helpers.PaginatedList<soccer.Models.Player>
@{
    ViewData["Title"] = "Oyuncular";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title"><i class="fe fe-users mr-2"></i>Oyuncular</h1>
    <div class="page-options d-flex">
        <a asp-action="Create" class="btn btn-primary"><i class="fe fe-plus mr-1"></i> Yeni Oyuncu</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <form method="get" class="d-flex w-100">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control mr-2" placeholder="Oyuncu axtar..." />
            <button type="submit" class="btn btn-outline-primary"><i class="fe fe-search"></i></button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fe fe-users"></i>
            <p>Hec bir oyuncu tapilmadi.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table card-table table-vcenter table-striped">
                <thead>
                    <tr>
                        <th></th>
                        <th>Ad</th>
                        <th>Komanda</th>
                        <th>Nomre</th>
                        <th>Movqe</th>
                        <th class="text-right">Emeliyyat</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" class="thumb-sm" />
                            }
                            else
                            {
                                <span class="avatar">@p.Name.Substring(0,1)</span>
                            }
                        </td>
                        <td>@p.Name</td>
                        <td>@p.TeamName</td>
                        <td><span class="badge badge-secondary">#@p.Number</span></td>
                        <td>@p.Position</td>
                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Etrafli"><i class="fe fe-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Redakte et"><i class="fe fe-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Sil"><i class="fe fe-trash-2"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div class="card-footer">
        <nav>
            <ul class="pagination mb-0">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-searchString="@ViewData["CurrentFilter"]">Evvelki</a></li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">Evvelki</span></li>
                }

                <li class="page-item active"><span class="page-link">@Model.PageIndex</span></li>

                @if (Model.HasNextPage)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-searchString="@ViewData["CurrentFilter"]">Novbeti</a></li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">Novbeti</span></li>
                }
            </ul>
        </nav>
    </div>
</div>
