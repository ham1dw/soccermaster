@model soccer.Models.Player
@{
    ViewData["Title"] = "Oyuncunu Sil";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title text-danger"><i class="fe fe-alert-triangle mr-2"></i>Oyuncunu Sil</h1>
</div>

<div class="card">
    <div class="card-body">
        <p class="text-muted">Bu oyuncunu silmek istediyinize eminsiniz? Bu emeliyyat geri qaytarila bilmez.</p>
        <div class="row align-items-center mb-3">
            <div class="col-auto">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" style="width:70px;height:70px;object-fit:cover;border-radius:8px;" />
                }
            </div>
            <div class="col">
                <h4 class="mb-0">@Model.Name</h4>
                <span class="text-muted">@Model.TeamName &middot; #@Model.Number &middot; @Model.Position</span>
            </div>
        </div>
    </div>
    <div class="card-footer text-right">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-outline-secondary">Legv et</a>
            <button type="submit" class="btn btn-danger">Beli, sil</button>
        </form>
    </div>
</div>
